// WAP to check whether the string is Palindrome or not using Pointer. 
#include <stdio.h>
#include <string.h>

void main() {
    char str[100];
    char *ptr = str;
    int len, i, isPalindrome = 1;

    printf("Enter a string: ");
    scanf("%s", str);
    len = strlen(str);

    for (i = 0; i < len / 2; i++) {
        if (*(ptr + i) != *(ptr + len - 1 - i)) {
            isPalindrome = 0;
            break;
        }
    }

    if (isPalindrome) {
        printf("The string is a palindrome.\n");
    } else {
        printf("The string is not a palindrome.\n");
    }
}
